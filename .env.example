# Kopiraj u .env (NE commitati) i popuni. Sve su obavezne osim onih s zadanom vrijednosti.
APP_KEY=base64:ZAMIJENI_php_app_bin_gen-key.php
DB_PASS=ZAMIJENI_jaka_lozinka

# BASE_URL=https://cjenik.sm-it.hr
# Ograniciti pristup: zarez-odvojene IP adrese ili CIDR. Prazno = bez ogranicenja (samo za razvoj).
# INGEST_ALLOWED_IPS=
# ADMIN_ALLOWED_IPS=
# Iza reverse proxyja koji postavlja stvarnu IP klijenta, npr. HTTP_X_FORWARDED_FOR (inace ostaviti prazno).
# CLIENT_IP_HEADER=
# false samo za lokalni razvoj bez HTTPS-a:
# REQUIRE_HTTPS=true
# OPERATOR_NAME=SM-IT
# ALERT_EMAIL=
